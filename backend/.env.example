# Lever Trading Backend v4.0

# ─── Vault Contract (Arbitrum) ─────────────────────────────────────────────
# Deployed LeverVault contract address on Arbitrum One
VAULT_ADDRESS=0xYourVaultContractAddress

# Arbitrum RPC endpoint
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Operator private key — the backend's vault operator key
# Must be registered as operator in the vault contract
# KEEP THIS SECRET — never expose to frontend
OPERATOR_KEY=0xYourOperatorPrivateKeyHere

# ─── Treasury & HL ──────────────────────────────────────────────────────────
# Treasury wallet address (receives platform fees)
TREASURY_ADDRESS=0xYourTreasuryAddressHere

# HL master account private key (for placing orders on behalf of users)
# KEEP THIS SECRET
HL_PRIVATE_KEY=0xYourHLPrivateKeyHere

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/lever

# ─── APIs ───────────────────────────────────────────────────────────────────
HL_API_URL=https://api.hyperliquid.xyz
HL_TESTNET_URL=https://api.hyperliquid-testnet.xyz

# ─── Frontend CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://lever-longshort.vercel.app,https://jb-dash.vercel.app,http://localhost:3000

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_EXPIRY_SECONDS=86400