# Lever Frontend Environment Variables

# WalletConnect project ID (get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=lever-mvp-placeholder

# LeverVault contract address on Arbitrum (set after deployment)
# NEXT_PUBLIC_VAULT_ADDRESS=0x...

# Backend API URL
NEXT_PUBLIC_API_URL=https://tbb-site.onrender.com

# Hyperliquid API endpoints
NEXT_PUBLIC_HL_API_URL=https://api.hyperliquid.xyz
NEXT_PUBLIC_HL_TESTNET_URL=https://api.hyperliquid-testnet.xyz

# Drift program ID
NEXT_PUBLIC_DRIFT_PROGRAM_ID=dRiftyHA39MWEi3m9HuxDgBqBksGq3b3Nv8m8E6jDgPv

# Solana RPC (Helius or QuickNode — required for Kamino/Lavarage tx signing)
# Free tier: https://dev.helius.xyz → 1M credits/month
# NEXT_PUBLIC_SOL_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Lavarage API key (optional — enables true leverage on any Solana token)
# Apply at https://www.lavarage.xyz/partners
# NEXT_PUBLIC_LAVARAGE_API_KEY=your_lavarage_api_key